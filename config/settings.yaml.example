# Copy to settings.yaml to override defaults (the app also writes this file via /config).
# data_dir: C:\Users\me\lma-data     # models, index, memory, snapshots, logs
# project: C:\Projects\MyMendixApp
mode: agent                          # ask | plan | agent | code | review | mendix | vision
use_system_trust_store: true          # trust corporate root CAs (TLS inspection) - never disable certificate checks
# proxy: http://127.0.0.1:3128       # e.g. a local Px/CNTLM; used when HTTPS_PROXY is not set (default: Windows PAC/WPAD)
llm:
  context_size: 16384                # tokens; lower it (8192) on machines with little RAM/VRAM
  gpu_layers: -1                     # -1 = let llama.cpp fit layers into VRAM automatically, 0 = CPU only
  temperature: 0.2
  max_output_tokens: 2048
  # Sampling: models in config/models.yaml carry their model-card recommendation (`sampling:`),
  # which wins over temperature/top_p/top_k/min_p/repeat_penalty here. Override one model:
  #   /config llm.sampling.qwen3-coder-30b.temperature 0.5
  # sampling:
  #   qwen3-coder-30b: {temperature: 0.7, top_p: 0.8, top_k: 20, repeat_penalty: 1.05}
  repeat_penalty: 1.0                # >1.0 (e.g. 1.05) discourages looping
  # top_p: 0.8
  # top_k: 20
  # min_p: 0.0
  loop_guard: true                   # stop a reply that keeps repeating the same text
  hf_endpoint: https://huggingface.co    # or a corporate Hugging Face mirror
  model_source: auto                 # auto = Hugging Face, then the GitHub mirror | hf | github (Hugging Face blocked)
  models_repo: FalconDevX/local-mendix-agent   # GitHub repo whose release 'models_tag' holds the mirror
  models_tag: models
agent:
  max_steps: 25
  plan_first: true
  auto_apply_edits: false            # true = write staged edits without asking
  allow_shell: false                 # true = expose run_command (still asks every time)
  multi_agent: true                  # the agent may hand sub-tasks to sub-agents (delegate tool); /team works either way
  parallel_agents: 2                 # sub-agents running at the same time
  # role_models: {explorer: qwen3-1.7b}   # a different installed model per sub-agent role
# extra_dirs: {'C:\Projects\MyMendixApp': ['C:\Projects\shared-lib']}   # written by /add-dir
ui:
  glyphs: auto                       # auto | unicode | safe | ascii
index:
  watch_interval_s: 0                # >0 = re-index changed files every N seconds
